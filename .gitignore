# Visual Studio Code
# Everything under .vscode/ is personal state, except the handful of files a
# project may deliberately share - drop the exceptions if you want none of it.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.vscode-test/
.history/
*.vsix
*.code-workspace

# Operating system
.DS_Store
.AppleDouble
Thumbs.db
Desktop.ini
